rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Vérifie si l'utilisateur est connecté
    function isAuthenticated() {
      return request.auth != null;
    }

    // Vérifie si l'utilisateur accède à ses propres données
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Vérifie si l'utilisateur connecté est un pharmacien (rôle stocké dans son profil utilisateur)
    function isPharmacist() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'pharmacist';
    }

    // 1. Collection Utilisateurs (users)
    // Plus de lecture publique : propriétaire ou pharmacien uniquement.
    match /users/{userId} {
      allow get: if isOwner(userId) || isPharmacist();
      allow list: if isPharmacist();
      // Inscription : uniquement son propre document, rôle parmi ceux proposés à l'inscription
      allow create: if isOwner(userId)
        && request.resource.data.role in ['patient', 'pharmacist'];
      // Mise à jour par le propriétaire, sans changer son rôle
      allow update: if isOwner(userId)
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    // 1b. Recherche minimale avant connexion (nom / email de récupération -> email de connexion)
    // Lecture par ID uniquement (pas de listing / énumération).
    match /login_lookup/{key} {
      allow get: if true;
      allow list: if false;
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly(['uid', 'loginEmail'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.loginEmail == request.auth.token.email;
      allow update: if isAuthenticated()
        && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'loginEmail'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.loginEmail == request.auth.token.email;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // 2. Collection Catalogue de Médicaments (products)
    match /products/{productId} {
      // Tout le monde peut consulter le catalogue des médicaments
      allow read: if true;
      // Seuls les pharmaciens peuvent modifier les produits
      allow write: if isPharmacist();
    }

    // 3. Collection de Discussion (messages)
    match /messages/{messageId} {
      allow read, write: if isAuthenticated();
    }

    // 4. Collection des Commandes (orders)
    match /orders/{orderId} {
      // Un patient peut créer et voir ses propres commandes. Le pharmacien peut toutes les gérer.
      allow create: if isAuthenticated() && request.resource.data.patientId == request.auth.uid;
      allow read: if isAuthenticated() && (resource.data.patientId == request.auth.uid || isPharmacist());
      allow update: if isAuthenticated() && (resource.data.patientId == request.auth.uid || isPharmacist());
      allow delete: if isPharmacist();
    }
  }
}
