rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Vérifie si l'utilisateur est connecté
    function isAuthenticated() {
      return request.auth != null;
    }

    // Vérifie si l'utilisateur accède à ses propres données
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Profil de l'utilisateur connecté
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Pharmacien VALIDÉ : rôle 'pharmacist' ET status 'approved'.
    // Un pharmacien inscrit lui-même démarre en status 'pending' et n'a AUCUN droit
    // pharmacien tant qu'il n'a pas été validé.
    function isApprovedPharmacist() {
      return isAuthenticated()
        && me().get('role', '') == 'pharmacist'
        && me().get('status', '') == 'approved';
    }

    // Administrateur : rôle 'admin', attribué uniquement à la main (console / Admin SDK),
    // jamais via l'inscription.
    function isAdmin() {
      return isAuthenticated() && me().get('role', '') == 'admin';
    }

    // Personnel habilité : pharmacien validé ou admin
    function isStaff() {
      return isApprovedPharmacist() || isAdmin();
    }

    // Champs de validation : jamais modifiables par l'utilisateur lui-même
    function privilegedKeys() {
      return ['role', 'status', 'validatedBy', 'validatedAt'];
    }

    // 1. Collection Utilisateurs (users)
    // Champs : role ('patient' | 'pharmacist' | 'admin'),
    //          status ('pending' | 'approved', pharmaciens uniquement),
    //          validatedBy (uid du valideur), validatedAt (horodatage serveur).
    match /users/{userId} {
      // Propriétaire (y compris pharmacien en attente) ou personnel habilité
      allow get: if isOwner(userId) || isStaff();
      // Listing (ex. pharmaciens en attente) : personnel habilité uniquement
      allow list: if isStaff();

      // Inscription : uniquement son propre document.
      //  - patient : sans status (absent ou null)
      //  - pharmacien : status forcé à 'pending'
      //  - jamais 'admin', jamais validatedBy / validatedAt
      allow create: if isOwner(userId)
        && !request.resource.data.keys().hasAny(['validatedBy', 'validatedAt'])
        && (
          (request.resource.data.role == 'patient'
            && request.resource.data.get('status', null) == null)
          || (request.resource.data.role == 'pharmacist'
            && request.resource.data.get('status', null) == 'pending')
        );

      // Mise à jour par le propriétaire : champs non privilégiés uniquement
      // (jamais role, status, validatedBy, validatedAt)
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(privilegedKeys());

      // Validation d'un pharmacien en attente par un pharmacien validé ou un admin :
      // status 'pending' (ou absent, comptes historiques) -> 'approved',
      // avec validatedBy = uid du valideur et validatedAt = horodatage serveur, rien d'autre.
      allow update: if isStaff()
        && request.auth.uid != userId
        && resource.data.get('role', '') == 'pharmacist'
        && resource.data.get('status', 'pending') == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'validatedBy', 'validatedAt'])
        && request.resource.data.status == 'approved'
        && request.resource.data.validatedBy == request.auth.uid
        && request.resource.data.validatedAt == request.time;

      allow delete: if false;
    }

    // 1b. Recherche minimale avant connexion (nom / email de récupération -> email de connexion)
    // Lecture par ID uniquement (pas de listing / énumération).
    match /login_lookup/{key} {
      allow get: if true;
      allow list: if false;
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly(['uid', 'loginEmail'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.loginEmail == request.auth.token.email;
      allow update: if isAuthenticated()
        && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'loginEmail'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.loginEmail == request.auth.token.email;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // 2. Collection Catalogue de Médicaments (products)
    match /products/{productId} {
      // Tout le monde peut consulter le catalogue des médicaments
      allow read: if true;
      // Seuls les pharmaciens validés (ou un admin) peuvent modifier les produits
      allow write: if isStaff();
    }

    // 3. Collection de Discussion (messages)
    // Un document par message, entre deux utilisateurs :
    //   { senderId, receiverId, participants: [senderId, receiverId], text, timestamp,
    //     read: false, (optionnel) id, orderId }
    // Seuls les deux participants lisent le message ; aucun accès global du personnel.
    function isParticipant(data) {
      return isAuthenticated()
        && (request.auth.uid in data.participants
            || data.senderId == request.auth.uid
            || data.receiverId == request.auth.uid);
    }

    match /messages/{messageId} {
      // get et list : uniquement si l'utilisateur est participant. Les requêtes doivent
      // donc être filtrées sur l'uid (participants array-contains uid, ou senderId / receiverId == uid).
      allow read: if isParticipant(resource.data);

      // Création : l'expéditeur est l'utilisateur connecté, participants = exactement
      // l'expéditeur et le destinataire (distincts), message non lu, texte non vide (2000 max).
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly(['id', 'senderId', 'receiverId', 'participants', 'text', 'timestamp', 'read', 'orderId'])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.receiverId is string
        && request.resource.data.receiverId != request.auth.uid
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.receiverId in request.resource.data.participants
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.get('read', false) == false;

      // Mise à jour : uniquement le destinataire, pour marquer le message comme lu.
      allow update: if isAuthenticated()
        && resource.data.receiverId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt'])
        && request.resource.data.read == true
        && request.resource.data.get('readAt', request.time) == request.time;

      allow delete: if false;
    }

    // 4. Collection des Commandes (orders)
    // Statuts (enum OrderStatus du client) : 'pending', 'validated', 'rejected',
    // 'delivering', 'delivered', plus 'cancelled' (annulation par le patient).
    match /orders/{orderId} {
      // Un patient crée ses propres commandes, toujours au statut 'pending'.
      allow create: if isAuthenticated()
        && request.resource.data.patientId == request.auth.uid
        && request.resource.data.status == 'pending';
      // Le patient voit ses commandes ; un pharmacien validé (ou un admin) les voit toutes.
      allow read: if isAuthenticated() && (resource.data.patientId == request.auth.uid || isStaff());

      // Patient : seule l'annulation est permise, 'pending' -> 'cancelled', en ne modifiant que
      // status (+ updatedAt / cancelledAt facultatifs, horodatage serveur).
      allow update: if isAuthenticated()
        && resource.data.patientId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'cancelledAt'])
        && (!('updatedAt' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.updatedAt == request.time)
        && (!('cancelledAt' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.cancelledAt == request.time);

      // Personnel habilité : gestion complète des commandes.
      allow update: if isStaff();
      allow delete: if isStaff();
    }
  }
}
